
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Conditions
#
set expression {tb_pipeline.dut.genblk1[0].i_line_buf.ram[15:0]}
if {[catch {condition new -name  buf_0 -expr $expression}] != ""} {
    condition set -using buf_0 -expr $expression
}
set expression {tb_pipeline.dut.genblk1[1].i_line_buf.ram[15:0]}
if {[catch {condition new -name  buf_1 -expr $expression}] != ""} {
    condition set -using buf_1 -expr $expression
}
set expression {tb_pipeline.dut.genblk1[2].i_line_buf.ram[15:0]}
if {[catch {condition new -name  buf_2 -expr $expression}] != ""} {
    condition set -using buf_2 -expr $expression
}
set expression {tb_pipeline.dut.genblk1[3].i_line_buf.ram[15:0]}
if {[catch {condition new -name  buf_3 -expr $expression}] != ""} {
    condition set -using buf_3 -expr $expression
}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {tb_pipeline.dut.clk_i}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_pipeline.dut.rstn_i}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_pipeline.dut.red_i[7:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_pipeline.dut.green_i[7:0]}]}
	} ]]
waveform format $id -bgcolor #000000
set id [waveform add -signals [subst  {
	{[format {tb_pipeline.dut.blue_i[7:0]}]}
	} ]]
waveform format $id -bgcolor #000000
