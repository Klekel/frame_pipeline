	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_pipeline.dut.wr_en[3:0]}]}
	} ]]
waveform format $id -bgcolor #000000
set id [waveform add -signals [subst  {
	{[format {buf_0[15:0]}]}
	} ]]
waveform format $id -bgcolor #000000
